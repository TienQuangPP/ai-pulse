# Không bắt buộc. Có token: 5.000 request/giờ thay vì 60.
GITHUB_TOKEN=
# Optional directory for local events and settings (default: .runtime/)
AIPULSE_DATA_DIR=
# live | demo
AIPULSE_MODE=live
POLL_INTERVAL_SECONDS=30
PORT=8787
# 0.0.0.0 để truy cập từ máy khác trong mạng LAN
HOST=127.0.0.1
# Không bắt buộc: bật chat "Hỏi AI Pulse" (cần chạy npm install một lần)
ANTHROPIC_API_KEY=
# Bắt buộc nên đặt khi mở server ra mạng (HOST=0.0.0.0 / Docker): mọi thao tác ghi cần token này
AIPULSE_ADMIN_TOKEN=
# Tên miền được phép truy cập ngoài localhost/IP, cách nhau bởi dấu phẩy (chống DNS rebinding)
AIPULSE_ALLOWED_HOSTS=
